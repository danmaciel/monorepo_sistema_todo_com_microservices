# Copy to .env locally and provide unique values; .env must remain untracked.
USER_DB_PASSWORD=
TODO_DB_PASSWORD=
JWT_SECRET=

# Optional RS256 mode (PKCS#8 private DER / X.509 public DER, base64 encoded).
# Generate and keep the private key outside Git. Set both keys together.
# When RS256 is enabled JWT_SECRET is not needed, including on Todo Service.
# JWT_RSA_PRIVATE_KEY_BASE64=
# JWT_RSA_PUBLIC_KEY_BASE64=
